# Copie ce fichier vers .env et remplis les valeurs réelles. Ne jamais committer .env !

# URL de connexion Neon — Dashboard Neon > ton projet > "Connection string"
# (utilise la version "pooled connection" fournie par Neon)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Token Vercel Blob — Dashboard Vercel > Storage > ton Blob store > .env.local
# Sert à uploader les images produits / fichiers .glb (modèles 3D)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# Chaîne aléatoire longue, utilisée pour signer les JWT.
# Génère-la avec: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-moi-avec-une-chaine-aleatoire-longue

# Port du serveur local (non utilisé sur Vercel)
PORT=3000
